{
  "name": "abastocontrol-backend",
  "version": "1.0.0",
  "description": "API REST de AbastoControl: inventario, ventas, pedidos y reportes para una bodega MYPE",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "lint": "eslint src tests scripts",
    "crear-admin": "node scripts/crear-admin.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/services/**/*.js", "src/domain/**/*.js", "src/strategies/**/*.js", "src/utils/**/*.js"],
    "coverageThreshold": { "global": { "statements": 70, "branches": 60, "functions": 70, "lines": 70 } }
  }
}
