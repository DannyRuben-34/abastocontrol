digraph G {
  rankdir=LR; fontname="Helvetica"; node [shape=plain, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, arrowhead=crow, arrowtail=tee, dir=both];
  labelloc=t; label="Figura 2.3. Modelo entidad-relación (modelo físico en MySQL)"; fontsize=14;
  usuario [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>usuario</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>nombre VARCHAR(100)<br align="left"/>usuario VARCHAR(50) UNIQUE<br align="left"/>hash_contrasena VARCHAR(100)<br align="left"/>rol ENUM(admin,vendedor)<br align="left"/>activo TINYINT<br align="left"/>intentos_fallidos INT<br align="left"/></td></tr></table>>];
  categoria [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>categoria</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>nombre VARCHAR(60)<br align="left"/></td></tr></table>>];
  producto [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>producto</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>codigo VARCHAR(30) UNIQUE<br align="left"/>nombre VARCHAR(120)<br align="left"/>FK categoria_id<br align="left"/>precio_venta DECIMAL(10,2)<br align="left"/>costo DECIMAL(10,2)<br align="left"/>stock INT<br align="left"/>stock_minimo INT<br align="left"/>fecha_vencimiento DATE<br align="left"/>activo TINYINT<br align="left"/></td></tr></table>>];
  proveedor [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>proveedor</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>nombre VARCHAR(100)<br align="left"/>telefono VARCHAR(20)<br align="left"/>activo TINYINT<br align="left"/></td></tr></table>>];
  compra [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>compra</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>FK proveedor_id<br align="left"/>FK usuario_id<br align="left"/>fecha DATETIME<br align="left"/>total DECIMAL(10,2)<br align="left"/></td></tr></table>>];
  detalle_compra [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>detalle_compra</b></td></tr><hr/><tr><td align="left">PK,FK compra_id<br align="left"/>PK,FK producto_id<br align="left"/>cantidad INT<br align="left"/>costo_unitario DECIMAL(10,2)<br align="left"/></td></tr></table>>];
  cliente [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>cliente</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>nombre VARCHAR(100)<br align="left"/>telefono VARCHAR(20)<br align="left"/>consentimiento_datos TINYINT<br align="left"/>saldo_fiado DECIMAL(10,2)<br align="left"/></td></tr></table>>];
  venta [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>venta</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>FK usuario_id<br align="left"/>FK cliente_id (NULL)<br align="left"/>fecha DATETIME (índice)<br align="left"/>medio_pago ENUM<br align="left"/>total DECIMAL(10,2)<br align="left"/>estado ENUM(confirmada,anulada)<br align="left"/></td></tr></table>>];
  detalle_venta [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>detalle_venta</b></td></tr><hr/><tr><td align="left">PK,FK venta_id<br align="left"/>PK,FK producto_id<br align="left"/>cantidad INT<br align="left"/>precio_unitario DECIMAL(10,2)<br align="left"/></td></tr></table>>];
  pedido [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>pedido</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>FK cliente_id<br align="left"/>FK responsable_id (usuario)<br align="left"/>FK venta_id (NULL)<br align="left"/>modalidad ENUM(recojo,reparto)<br align="left"/>estado ENUM (índice)<br align="left"/>notas VARCHAR(255)<br align="left"/>fecha_creacion DATETIME<br align="left"/></td></tr></table>>];
  pago_fiado [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>pago_fiado</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>FK cliente_id<br align="left"/>FK usuario_id<br align="left"/>monto DECIMAL(10,2)<br align="left"/>fecha DATETIME<br align="left"/></td></tr></table>>];
  cierre_caja [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>cierre_caja</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>FK usuario_id<br align="left"/>fecha DATE UNIQUE<br align="left"/>total_efectivo, total_digital<br align="left"/>total_fiado, diferencia<br align="left"/></td></tr></table>>];
  bitacora [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td bgcolor="#D9EAD3"><b>bitacora</b></td></tr><hr/><tr><td align="left">PK id<br align="left"/>FK usuario_id<br align="left"/>fecha DATETIME<br align="left"/>accion, entidad, id_entidad<br align="left"/></td></tr></table>>];
  categoria -> producto; proveedor -> compra; usuario -> compra; compra -> detalle_compra; producto -> detalle_compra;
  usuario -> venta; cliente -> venta; venta -> detalle_venta; producto -> detalle_venta;
  cliente -> pedido; venta -> pedido; usuario -> pedido; usuario -> cierre_caja; cliente -> pago_fiado; usuario -> pago_fiado; usuario -> bitacora;
}
